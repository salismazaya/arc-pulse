# ArcPulse Environment Configuration

# Active Network: 'arcMainnet' or 'arcTestnet'
NETWORK=arcMainnet

# Deployer / Relayer Private Key (Hex without 0x or with 0x)
DEPLOYER_PRIVATE_KEY=your_private_key_here

# Network RPC Endpoints
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io

# Relayer Parameters
RELAYER_INTERVAL_MS=60000
DEVIATION_THRESHOLD_PCT=0.05
